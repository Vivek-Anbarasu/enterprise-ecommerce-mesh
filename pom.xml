<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.enterprise.mesh</groupId>
    <artifactId>enterprise-ecommerce-mesh</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Enterprise Ecommerce Mesh</name>
    <description>Enterprise e-commerce service mesh, deployable to Azure AKS</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <springdoc.version>3.1.1</springdoc.version>
        <jib.version>3.5.2</jib.version>
        <!-- Pinned to the exact version spring-cloud-starter-circuitbreaker-resilience4j
             pulls in for circuitbreaker and timelimiter. The semaphore bulkhead the
             gateway uses for route isolation is released separately by that starter, so
             it has to be requested explicitly; declaring it without a version here would
             let it drift away from the circuit breaker it is configured alongside. -->
        <resilience4j.version>2.3.0</resilience4j.version>

        <!-- Container image coordinates; override in CI with -D -->
        <docker.registry>acrenterprise.azurecr.io</docker.registry>
        <docker.namespace>ecommerce</docker.namespace>
        <docker.image.tag>${project.version}</docker.image.tag>

        <!-- Quality gates -->
        <jacoco.line.coverage>0.70</jacoco.line.coverage>
        <skipITs>true</skipITs>
    </properties>

    <modules>
        <module>common-bom</module>
        <module>api-gateway</module>
        <module>bff-service</module>
        <module>core-services/customer-service</module>
        <module>core-services/order-service</module>
        <module>core-services/payment-service</module>
        <module>catalog-services/product-catalog-service</module>
        <module>catalog-services/review-rating-service</module>
        <module>transactional-caches/shopping-cart-service</module>
        <module>transactional-caches/inventory-service</module>
        <module>async-processors/notification-service</module>
        <module>async-processors/shipping-delivery-service</module>
        <module>ai-orchestrator-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal shared libraries -->
            <dependency>
                <groupId>com.enterprise.mesh</groupId>
                <artifactId>common-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise.mesh</groupId>
                <artifactId>common-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise.mesh</groupId>
                <artifactId>common-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third-party not covered by the imported BOMs -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bulkhead</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-reactor</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Every service gets test + actuator scaffolding -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.6.0</version>
                    <configuration>
                        <skipITs>${skipITs}</skipITs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <layers>
                            <enabled>true</enabled>
                        </layers>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib.version}</version>
                    <configuration>
                        <container>
                            <name>${docker.registry}/${docker.namespace}/${project.artifactId}:${docker.image.tag}</name>
                            <ports>
                                <port>8080</port>
                            </ports>
                        </container>
                        <outputPaths>
                            <tar>
                                <path>${project.build.directory}/${project.artifactId}-${docker.image.tag}.tar</path>
                            </tar>
                        </outputPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn -Pcontainer package  -> produces ${artifactId}-${version}.tar per module -->
        <profile>
            <id>container</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.google.cloud.tools</groupId>
                        <artifactId>jib-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jib-tar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>buildTar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- mvn -Pjib package -> pushes straight to ACR -->
        <profile>
            <id>jib</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.google.cloud.tools</groupId>
                        <artifactId>jib-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jib-push</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
