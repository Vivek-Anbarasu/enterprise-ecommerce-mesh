        <mxCell id="sec_e17" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#B91C1C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=9;fontColor=#7F1D1D;labelBackgroundColor=#FFFFFF;" value="17. clear cookie&lt;br&gt;302 to Entra /logout">
