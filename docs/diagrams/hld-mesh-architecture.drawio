        <mxCell id="sec_panel_direct" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;" value="&lt;b&gt;DIRECT CLIENTS — BYPASS THE BFF&lt;/b&gt;" vertex="1">
          <mxGeometry height="380" width="600" x="40" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="sec_mobile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" value="&lt;b&gt;Mobile — public client&lt;/b&gt;&lt;br&gt;Entra &lt;b&gt;authorization_code + PKCE&lt;/b&gt;&lt;br&gt;access token → AGC → api-gateway → services&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;No BFF, no cookie, no client secret.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="560" x="60" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="sec_partner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" value="&lt;b&gt;Partner — confidential client&lt;/b&gt;&lt;br&gt;Entra &lt;b&gt;client_credentials&lt;/b&gt;&lt;br&gt;access token → AGC → api-gateway → services&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;No BFF, no user session.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="560" x="60" y="1185" as="geometry" />
        </mxCell>
        <mxCell id="sec_direct_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1;fontFamily=Segoe UI;fontSize=9;fontColor=#7C2D12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" value="&lt;b&gt;Both bypass the BFF.&lt;/b&gt; The gateway applies the same JWT validation: issuer, audience, signature, expiry, tenant." vertex="1">
          <mxGeometry height="50" width="560" x="60" y="1315" as="geometry" />
        </mxCell>
        <mxCell id="sec_panel_trust" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;" value="&lt;b&gt;TRUST BOUNDARIES + CONTROLS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Entra ID&lt;/b&gt; — browser authorization_code; mobile PKCE; partner client_credentials; logout.&lt;br&gt;&lt;br&gt;&lt;b&gt;AGC&lt;/b&gt; — TLS termination, WAF, rate limit; no SPIFFE identity.&lt;br&gt;&lt;br&gt;&lt;b&gt;BFF&lt;/b&gt; — only browser token holder; HttpOnly / Secure / SameSite cookie; CSRF; Redis session; no waypoint, so the gateway hop is L4 mTLS.&lt;br&gt;&lt;br&gt;&lt;b&gt;api-gateway&lt;/b&gt; — Validates JWT - issuer / audience / signature / expiry; tenant re-derived; client X-Tenant-ID stripped; rate limit.&lt;br&gt;&lt;br&gt;&lt;b&gt;ztunnel / waypoint&lt;/b&gt; — mTLS STRICT; L7 authz; 9 services enrolled; PERMISSIVE only on AGC ports 8080 / 8091.&lt;br&gt;&lt;br&gt;&lt;b&gt;Key Vault&lt;/b&gt; — CSI keys and secrets; never env vars; no tokens in logs." vertex="1">
          <mxGeometry height="380" width="600" x="660" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="sec_panel_threats" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;" value="&lt;b&gt;THREAT CONTROLS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;XSS / token theft&lt;/b&gt; — HttpOnly cookie; no token in browser JS.&lt;br&gt;&lt;br&gt;&lt;b&gt;CSRF&lt;/b&gt; — CSRF token + SameSite; BFF only.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tenant spoofing&lt;/b&gt; — gateway strips client X-Tenant-ID and re-derives from JWT.&lt;br&gt;&lt;br&gt;&lt;b&gt;Token replay&lt;/b&gt; — short-lived access tokens; issuer / audience / signature / expiry checked.&lt;br&gt;&lt;br&gt;&lt;b&gt;Secret leakage&lt;/b&gt; — Key Vault CSI; no env vars; redact Authorization.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lateral movement&lt;/b&gt; — mTLS STRICT + waypoint L7 authz; PERMISSIVE only on AGC ports." vertex="1">
          <mxGeometry height="380" width="600" x="1280" y="1020" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
