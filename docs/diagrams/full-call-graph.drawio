<mxfile host="app.diagrams.net" agent="hldgen">
  <diagram id="full-call-graph" name="Full Call Graph - Sync + Async">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="cg_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=18;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.5;align=left;verticalAlign=middle;arcSize=25;spacingLeft=14;" value="&lt;b&gt;Enterprise E-Commerce Mesh — Full Call Graph&lt;/b&gt; &lt;font color=#64748B size=2&gt;· sync HTTP + async events · rev 2026-10&lt;/font&gt;" vertex="1">
          <mxGeometry height="48" width="2720" x="40" y="20" as="geometry" />
        </mxCell>

        <mxCell id="cg_scope" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#475569;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.5;align=left;verticalAlign=middle;arcSize=20;spacingLeft=12;" value="&lt;b&gt;How to read:&lt;/b&gt; solid = synchronous HTTP · dashed teal = asynchronous event · dashed blue = identity / config · dashed gray = external / conditional · state stores are in node captions, not drawn as call edges. Service names may appear twice: API role and async producer / consumer role." vertex="1">
          <mxGeometry height="28" width="2720" x="40" y="72" as="geometry" />
        </mxCell>

        <mxCell id="z_clients" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;align=left;verticalAlign=top;arcSize=2;spacingLeft=12;spacingTop=7;" value="&lt;b&gt;CLIENTS + IDENTITY — OUTSIDE AKS&lt;/b&gt;" vertex="1">
          <mxGeometry height="170" width="2720" x="40" y="110" as="geometry" />
        </mxCell>

        <mxCell id="z_edge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;align=left;verticalAlign=top;arcSize=2;spacingLeft=12;spacingTop=7;" value="&lt;b&gt;EDGE — AGC (L7) + SPRING EDGE&lt;/b&gt;" vertex="1">
          <mxGeometry height="230" width="2720" x="40" y="300" as="geometry" />
        </mxCell>

        <mxCell id="z_sync" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#FCFBFF;strokeColor=#6D28D9;strokeWidth=2;align=left;verticalAlign=top;arcSize=2;spacingLeft=12;spacingTop=7;" value="&lt;b&gt;SYNCHRONOUS SERVICE CALLS — HTTP/1.1 THROUGH THE MESH · ztunnel L4 · waypoint L7&lt;/b&gt;" vertex="1">
          <mxGeometry height="760" width="2720" x="40" y="550" as="geometry" />
        </mxCell>

        <mxCell id="z_async" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;align=left;verticalAlign=top;arcSize=2;spacingLeft=12;spacingTop=7;" value="&lt;b&gt;ASYNCHRONOUS FLOWS — AZURE SERVICE BUS (KAFKA ENDPOINT :9093) · at-least-once&lt;/b&gt;" vertex="1">
          <mxGeometry height="560" width="2720" x="40" y="1330" as="geometry" />
        </mxCell>

        <mxCell id="z_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fontColor=#0F172A;fillColor=#FAFAFC;strokeColor=#E2E8F0;strokeWidth=1.5;align=left;verticalAlign=top;arcSize=2;spacingLeft=12;spacingTop=7;" value="&lt;b&gt;LEGEND&lt;/b&gt;" vertex="1">
          <mxGeometry height="220" width="2720" x="40" y="1910" as="geometry" />
        </mxCell>

        <mxCell id="cg_browser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;SPA · no bearer token&lt;/font&gt;&lt;br&gt;HttpOnly session cookie" vertex="1">
          <mxGeometry height="90" width="300" x="80" y="150" as="geometry" />
        </mxCell>

        <mxCell id="cg_mobile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;Mobile app&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;public client&lt;/font&gt;&lt;br&gt;authorization_code + PKCE" vertex="1">
          <mxGeometry height="90" width="300" x="420" y="150" as="geometry" />
        </mxCell>

        <mxCell id="cg_partner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;Partner integration&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;confidential client&lt;/font&gt;&lt;br&gt;client_credentials access token" vertex="1">
          <mxGeometry height="90" width="300" x="760" y="150" as="geometry" />
        </mxCell>

        <mxCell id="cg_entra" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fontColor=#0F172A;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;OAuth2 / OIDC&lt;/font&gt;&lt;br&gt;authorization_code · client_credentials" vertex="1">
          <mxGeometry height="90" width="380" x="1120" y="150" as="geometry" />
        </mxCell>

        <mxCell id="cg_identity_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=middle;arcSize=10;spacingLeft=12;dashed=1;dashPattern=6 4;" value="&lt;b&gt;Token acquisition&lt;/b&gt;&lt;br&gt;Browser: session cookie → BFF → Entra (code exchange + refresh)&lt;br&gt;Mobile: authorization_code + PKCE → Entra; bearer token to AGC&lt;br&gt;Partner: client_credentials → Entra; access token only; bearer token to AGC&lt;br&gt;Mobile / Partner bypass the BFF. Entra is not called through AGC." vertex="1">
          <mxGeometry height="90" width="1180" x="1540" y="150" as="geometry" />
        </mxCell>

        <mxCell id="cg_agc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;Azure Application Gateway for Containers (AGC)&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;L7 ingress · TLS 1.3 · WAF · IP rate limit&lt;/font&gt;&lt;br&gt;/bff/** + /login → bff-service:8091&lt;br&gt;/** → api-gateway:8080&lt;br&gt;&lt;font color=#64748B&gt;outside AKS · no SPIFFE identity · cannot speak HBONE&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="500" x="80" y="350" as="geometry" />
        </mxCell>

        <mxCell id="cg_bff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=8;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;bff-service :8091&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;session cookie → bearer · CSRF · Redis session store&lt;/font&gt;&lt;br&gt;&lt;b&gt;Aggregation surfaces&lt;/b&gt;&lt;br&gt;/bff/api/public/storefront → /api/products&lt;br&gt;/bff/api/dashboard → /api/customers/me · /api/cart · /api/orders · /api/ai/recommendations&lt;br&gt;/bff/api/session → token refresh / introspection" vertex="1">
          <mxGeometry height="130" width="400" x="620" y="350" as="geometry" />
        </mxCell>

        <mxCell id="cg_gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=8;fontColor=#0F172A;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;api-gateway :8080&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;Spring Cloud Gateway · JWT · tenant isolation · per-tenant rate limit · circuit breakers&lt;/font&gt;&lt;br&gt;&lt;b&gt;Routes&lt;/b&gt; · /api/products,/api/categories → product-catalog&lt;br&gt;/api/reviews → review-rating · /api/cart,/api/carts → shopping-cart&lt;br&gt;/api/customers → customer · /api/orders → order&lt;br&gt;/api/payments → payment · /api/inventory → inventory&lt;br&gt;/api/ai → ai-orchestrator&lt;br&gt;/internal/shipping → shipping · /internal/notifications → notification (actuator)&lt;br&gt;/internal/docs → swagger-ui (tooling)" vertex="1">
          <mxGeometry height="180" width="680" x="1060" y="340" as="geometry" />
        </mxCell>

        <mxCell id="cg_edge_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=8;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=middle;arcSize=10;spacingLeft=12;dashed=1;dashPattern=6 4;" value="&lt;b&gt;Edge notes&lt;/b&gt;&lt;br&gt;AGC is outside AKS: TLS 1.3 · WAF · IP rate limit · no SPIFFE identity · cannot speak HBONE. It routes /bff/** and /login to BFF, everything else to the gateway.&lt;br&gt;Gateway is the only business HTTP entry into the mesh: JWT validation · tenant isolation · per-tenant rate limit · circuit breaker. It uses CoreDNS Service names; no service registry.&lt;br&gt;Secrets: Key Vault CSI." vertex="1">
          <mxGeometry height="180" width="940" x="1780" y="340" as="geometry" />
        </mxCell>

        <mxCell id="cg_catalog" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F8F7FF;strokeColor=#6D28D9;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;product-catalog-service :8085&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;Cosmos DB (Mongo, catalog_db) · Redis cache&lt;/font&gt;&lt;br&gt;/api/products · /api/categories · /api/products/sku/{sku}&lt;br&gt;publishes product.events (AFTER_COMMIT)" vertex="1">
          <mxGeometry height="100" width="360" x="100" y="620" as="geometry" />
        </mxCell>

        <mxCell id="cg_review" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F8F7FF;strokeColor=#6D28D9;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;review-rating-service :8088&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;Cosmos DB (Mongo, reviews_db)&lt;/font&gt;&lt;br&gt;/api/reviews/**&lt;br&gt;no Kafka · no outbound calls" vertex="1">
          <mxGeometry height="100" width="360" x="100" y="760" as="geometry" />
        </mxCell>

        <mxCell id="cg_cart" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F8F7FF;strokeColor=#6D28D9;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;shopping-cart-service :8086&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;Redis (cart:*)&lt;/font&gt;&lt;br&gt;/api/cart/** · /api/carts/**&lt;br&gt;no outbound calls" vertex="1">
          <mxGeometry height="100" width="360" x="100" y="900" as="geometry" />
        </mxCell>

        <mxCell id="cg_order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F8F7FF;strokeColor=#6D28D9;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;order-service :8082&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;PostgreSQL (orders_db) · outbox_events · @Transactional saga&lt;/font&gt;&lt;br&gt;/api/orders/** · order.paid / order.failed&lt;br&gt;→ inventory (sync) · → payment (sync)" vertex="1">
          <mxGeometry height="100" width="360" x="720" y="620" as="geometry" />
        </mxCell>

        <mxCell id="cg_inventory" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F8F7FF;strokeColor=#6D28D9;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;inventory-service :8083&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;PostgreSQL (inventory_db) · optimistic locking · reservation sweeper&lt;/font&gt;&lt;br&gt;/api/inventory/**&lt;br&gt;called by order-service" vertex="1">
          <mxGeometry height="100" width="360" x="720" y="760" as="geometry" />
        </mxCell>

        <mxCell id="cg_payment" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F8F7FF;strokeColor=#6D28D9;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;payment-service :8084&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;PostgreSQL (payments_db) · provider tokenisation&lt;/font&gt;&lt;br&gt;/api/payments/** · called by order-service&lt;br&gt;→ provider (authorise · capture · refund)" vertex="1">
          <mxGeometry height="100" width="360" x="720" y="900" as="geometry" />
        </mxCell>

        <mxCell id="cg_customer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F8F7FF;strokeColor=#6D28D9;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;customer-service :8087&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;PostgreSQL (customers_db)&lt;/font&gt;&lt;br&gt;/api/customers/**&lt;br&gt;no outbound calls" vertex="1">
          <mxGeometry height="100" width="360" x="1340" y="620" as="geometry" />
        </mxCell>

        <mxCell id="cg_ai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F8F7FF;strokeColor=#6D28D9;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;ai-orchestrator-service :8090&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;Cosmos DB (Mongo, ai_db) · Redis caches&lt;/font&gt;&lt;br&gt;/api/ai/** · consumes order.events + product.events&lt;br&gt;→ product-catalog (sync category / candidate lookup)" vertex="1">
          <mxGeometry height="100" width="360" x="1340" y="760" as="geometry" />
        </mxCell>

        <mxCell id="cg_shipping" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;shipping-delivery-service :8089&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;PostgreSQL (shipping_db) · Kafka consumer · /internal/shipping&lt;/font&gt;&lt;br&gt;order.paid → create shipment&lt;br&gt;→ carrier adapter (purchaseLabel / cancelLabel)" vertex="1">
          <mxGeometry height="100" width="360" x="1340" y="900" as="geometry" />
        </mxCell>

        <mxCell id="cg_notification" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;notification-service (L4 only)&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;headless · :8081 actuator only · Redis dedupe&lt;/font&gt;&lt;br&gt;consumes order.events · dispatcher logs · no vendor call&lt;br&gt;no business HTTP surface" vertex="1">
          <mxGeometry height="100" width="360" x="1960" y="620" as="geometry" />
        </mxCell>

        <mxCell id="cg_sync_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=8;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=middle;arcSize=8;spacingLeft=12;dashed=1;dashPattern=6 4;" value="&lt;b&gt;Mesh data plane:&lt;/b&gt; every in-cluster edge traverses ztunnel L4; the 9 business services are waypoint-enrolled for L7 (per-request LB, retries, outlier ejection, path authz). api-gateway / bff-service / notification-service have no waypoint. istiod supplies xDS + workload certs but is not on the per-request path.&lt;br&gt;&lt;b&gt;Only 3 synchronous service-to-service calls:&lt;/b&gt; order→inventory, order→payment, ai→product-catalog. They use RestClient + X-Tenant-ID, no bearer token; mesh mTLS secures the hop." vertex="1">
          <mxGeometry height="180" width="540" x="100" y="1040" as="geometry" />
        </mxCell>

        <mxCell id="cg_ext_lane" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#475569;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;arcSize=6;spacingLeft=12;spacingTop=6;dashed=1;dashPattern=6 4;" value="&lt;b&gt;EXTERNAL EGRESS — provider adapters&lt;/b&gt;" vertex="1">
          <mxGeometry height="180" width="1040" x="680" y="1040" as="geometry" />
        </mxCell>

        <mxCell id="cg_payment_provider" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" value="&lt;b&gt;Payment provider API&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;HTTP adapter when PAYMENT_GATEWAY=http&lt;/font&gt;&lt;br&gt;authorise · capture · refund&lt;br&gt;&lt;font color=#B45309&gt;void is local status only; no provider call&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="720" y="1080" as="geometry" />
        </mxCell>

        <mxCell id="cg_carrier" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" value="&lt;b&gt;Carrier API&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;CarrierGateway seam · StubCarrierGateway in repo&lt;/font&gt;&lt;br&gt;purchaseLabel · cancelLabel" vertex="1">
          <mxGeometry height="90" width="360" x="1340" y="1080" as="geometry" />
        </mxCell>

        <mxCell id="cg_ext_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=8;fontColor=#475569;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=middle;arcSize=8;spacingLeft=12;dashed=1;dashPattern=6 4;" value="&lt;b&gt;External adapters&lt;/b&gt;&lt;br&gt;Payment is a real HTTP call only when the HTTP gateway is enabled; the local stub takes no money.&lt;br&gt;Carrier is a seam: the only implementation in the repo is StubCarrierGateway, which never contacts a real carrier.&lt;br&gt;notification-service has no external vendor: NotificationDispatcher logs instead of sending." vertex="1">
          <mxGeometry height="180" width="720" x="1960" y="760" as="geometry" />
        </mxCell>

        <mxCell id="cg_async_order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;order-service — producer role&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;same workload as above&lt;/font&gt;&lt;br&gt;INSERT outbox_events in the order transaction&lt;br&gt;event types: order.paid · order.failed" vertex="1">
          <mxGeometry height="100" width="380" x="100" y="1410" as="geometry" />
        </mxCell>

        <mxCell id="cg_async_catalog" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;product-catalog-service — producer role&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;same workload as above&lt;/font&gt;&lt;br&gt;publish product.events AFTER_COMMIT · not an outbox&lt;br&gt;types: product.created · updated · deactivated" vertex="1">
          <mxGeometry height="100" width="380" x="100" y="1550" as="geometry" />
        </mxCell>

        <mxCell id="cg_debezium" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;Debezium outbox connector&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;PostgreSQL WAL → EventRouter&lt;/font&gt;&lt;br&gt;table: outbox_events · route.by.field=topic&lt;br&gt;&lt;font color=#B45309&gt;Kafka Connect cluster is not in this repo&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="340" x="540" y="1410" as="geometry" />
        </mxCell>

        <mxCell id="cg_order_events" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;order.events&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;Kafka topic · key = aggregateId&lt;/font&gt;&lt;br&gt;CloudEvents ce_* headers&lt;br&gt;order.paid · order.failed" vertex="1">
          <mxGeometry height="100" width="360" x="940" y="1410" as="geometry" />
        </mxCell>

        <mxCell id="cg_product_events" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;product.events&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;Kafka topic · key = tenant:sku&lt;/font&gt;&lt;br&gt;CloudEvents ce_* headers&lt;br&gt;product.created · updated · deactivated" vertex="1">
          <mxGeometry height="100" width="360" x="940" y="1550" as="geometry" />
        </mxCell>

        <mxCell id="cg_notif_consumer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=9;fontColor=#0F172A;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b&gt;notification-service — consumer&lt;/b&gt;&lt;br&gt;&lt;font color=#64748B&gt;group notification-service · Redis dedupe 8d&lt;/font&gt;&lt;br&gt;all order events · dispatcher logs (no vendor)" vertex="1">
