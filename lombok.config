# Lombok configuration for the whole reactor.
#
# Applied to every module: config.stopBubbling stops a module-level
# lombok.config from silently inheriting and overriding this file.

config.stopBubbling = true

# Stamp generated members with @lombok.Generated.
#
# Not currently load-bearing: jacoco-maven-plugin 0.8.15 sits in the root pom's
# <pluginManagement> with no <executions>, and <plugins> declares only
# maven-compiler-plugin. The jacoco.line.coverage=0.70 property is therefore
# read by nothing and no coverage gate runs during the build - confirmed by a
# full `mvn clean install`, which produces no jacoco output.
#
# Keep this anyway. Without the annotation, the moment anyone wires up
# prepare-agent + check, every generated constructor, getter and setter counts
# as an uncovered line and the reported figure stops describing handwritten
# logic. Setting it now costs nothing and means the gate measures real code
# from its first run.
lombok.addLombokGeneratedAnnotation = true

# Carry these onto constructor parameters generated by @RequiredArgsConstructor,
# @AllArgsConstructor and friends.
#
# Without copyableAnnotations, Lombok does not copy @Value onto the generated
# constructor, so Spring sees an unannotated parameter and fails context startup
# with no candidate bean.
#
# This is only half the fix and is not sufficient alone. The annotation has to be
# actually present on the field first - lombok.config cannot copy an annotation
# that was never written. It was missing on two components that sit on the
# checkout and stock-expiry paths:
#   - order-service            saga/OutboxRelay
#   - inventory-service        service/ReservationExpirySweeper
# See docs/REQUEST-FLOW-END-TO-END.md section 15.7.
#
# One key per line: lombok.config has no line-continuation syntax.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier